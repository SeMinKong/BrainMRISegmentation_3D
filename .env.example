# Copy to .env; scripts/start.ps1 loads this file if present.
# Paths may be absolute or relative to this project directory.
MRI_DATA_DIR=.data

# Real cases: every study in this manifest is linked (not copied) into the web case list at startup.
# Unset = data/mu-glioma-post-manifest.json when it exists; "none" disables linking.
# Use data/mu-glioma-post-all-labeled.json to also browse the held-out duplicate studies.
MRI_SOURCE_MANIFEST=data/mu-glioma-post-manifest.json

# Synthetic phantom: auto (only when no real case is available), always, never.
MRI_DEMO_CASE=auto

# Trained project-format checkpoints only. Leave blank for the synthetic demo.
MRI_UNET_CHECKPOINT=
MRI_SWIN_CHECKPOINT=
MRI_NNUNET_MODEL_DIR=

# CPU works for viewing and smoke tests. For real training, install suitable GPU PyTorch.
MRI_DEVICE=cpu
